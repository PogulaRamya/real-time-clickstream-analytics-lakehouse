<workbook original-version="18.1" source-build="2024.1.0" source-platform="win" version="18.1">
  <preferences />
  <datasources>
    <datasource caption="Product performance" inline="true" name="products" version="18.1">
      <connection class="snowflake" server="YOUR_ACCOUNT.snowflakecomputing.com" dbname="CLICKSTREAM" schema="ANALYTICS" warehouse="CLICKSTREAM_WH" role="CLICKSTREAM_READER" authentication="auth-user-pass" username="">
        <relation name="PRODUCT_PERFORMANCE" table="[CLICKSTREAM].[ANALYTICS].[PRODUCT_PERFORMANCE]" type="table" />
      </connection>
      <column datatype="string" name="[PRODUCT_ID]" role="dimension" type="nominal" />
      <column datatype="real" name="[REVENUE_USD]" role="measure" type="quantitative" />
      <column datatype="date" name="[METRIC_DATE]" role="dimension" type="ordinal" />
    </datasource>
    <datasource caption="Finalized session funnel" inline="true" name="funnel" version="18.1">
      <connection class="snowflake" server="YOUR_ACCOUNT.snowflakecomputing.com" dbname="CLICKSTREAM" schema="ANALYTICS" warehouse="CLICKSTREAM_WH" role="CLICKSTREAM_READER" authentication="auth-user-pass" username="">
        <relation name="CONVERSION_FUNNEL" table="[CLICKSTREAM].[ANALYTICS].[CONVERSION_FUNNEL]" type="table" />
      </connection>
      <column datatype="date" name="[SESSION_DATE]" role="dimension" type="ordinal" />
      <column datatype="integer" name="[PRODUCT_VIEW_SESSIONS]" role="measure" type="quantitative" />
      <column datatype="integer" name="[CART_SESSIONS]" role="measure" type="quantitative" />
      <column datatype="integer" name="[CHECKOUT_SESSIONS]" role="measure" type="quantitative" />
      <column datatype="integer" name="[PURCHASE_SESSIONS]" role="measure" type="quantitative" />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Product revenue (USD)">
      <layout-options />
      <table>
        <view>
          <datasources>
            <datasource caption="products" name="products" />
          </datasources>
          <datasource-dependencies datasource="products">
            <column datatype="string" name="[PRODUCT_ID]" role="dimension" type="nominal" />
            <column datatype="real" name="[REVENUE_USD]" role="measure" type="quantitative" />
            <column datatype="date" name="[METRIC_DATE]" role="dimension" type="ordinal" />
            <column-instance column="[PRODUCT_ID]" derivation="None" name="[none:PRODUCT_ID:nk]" pivot="key" type="nominal" />
            <column-instance column="[REVENUE_USD]" derivation="Sum" name="[sum:REVENUE_USD:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view breakdown="auto" />
            <mark class="Bar" />
            <mark-sizing mark-sizing-setting="marks-scaling-on" />
          </pane>
        </panes>
        <rows>[products].[sum:REVENUE_USD:qk]</rows>
        <cols>[products].[none:PRODUCT_ID:nk]</cols>
      </table>
    </worksheet>
    <worksheet name="Finalized converted sessions">
      <layout-options />
      <table>
        <view>
          <datasources>
            <datasource caption="funnel" name="funnel" />
          </datasources>
          <datasource-dependencies datasource="funnel">
            <column datatype="date" name="[SESSION_DATE]" role="dimension" type="ordinal" />
            <column datatype="integer" name="[PRODUCT_VIEW_SESSIONS]" role="measure" type="quantitative" />
            <column datatype="integer" name="[CART_SESSIONS]" role="measure" type="quantitative" />
            <column datatype="integer" name="[CHECKOUT_SESSIONS]" role="measure" type="quantitative" />
            <column datatype="integer" name="[PURCHASE_SESSIONS]" role="measure" type="quantitative" />
            <column-instance column="[SESSION_DATE]" derivation="None" name="[none:SESSION_DATE:nk]" pivot="key" type="nominal" />
            <column-instance column="[PURCHASE_SESSIONS]" derivation="Sum" name="[sum:PURCHASE_SESSIONS:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view breakdown="auto" />
            <mark class="Bar" />
            <mark-sizing mark-sizing-setting="marks-scaling-on" />
          </pane>
        </panes>
        <rows>[funnel].[sum:PURCHASE_SESSIONS:qk]</rows>
        <cols>[funnel].[none:SESSION_DATE:nk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name="Clickstream overview">
      <style />
      <size maxheight="800" maxwidth="1200" minheight="800" minwidth="1200" />
      <zones>
        <zone h="100000" w="50000" x="0" y="0" id="1" name="Product revenue (USD)" type-v2="worksheet" />
        <zone h="100000" w="50000" x="50000" y="0" id="2" name="Finalized converted sessions" type-v2="worksheet" />
      </zones>
    </dashboard>
  </dashboards>
</workbook>